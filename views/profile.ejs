<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      color: #222;
      min-height: 100vh;
    }

    .navbar {
      background: #222;
      color: white;
      padding: 18px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .navbar h2 {
      font-size: 20px;
    }

    .logout {
      color: white;
      text-decoration: none;
      font-size: 14px;
    }

    .container {
      max-width: 1000px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .profile-card {
      background: white;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
      margin-bottom: 40px;
    }

    .profile-card h1 {
      margin-bottom: 25px;
    }

    .profile-info {
      margin-bottom: 25px;
    }

    .profile-info p {
      margin-bottom: 12px;
      font-size: 16px;
    }

    .label {
      font-weight: bold;
      margin-right: 8px;
    }

    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 10px 18px;
      border-radius: 7px;
      text-decoration: none;
      border: none;
      background: #222;
      color: white;
      cursor: pointer;
      font-size: 14px;
    }

    .btn:hover {
      background: #444;
    }

    .posts-title {
      margin-bottom: 20px;
    }

    .posts-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }

    .post-card {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    .post-card h2 {
      margin-bottom: 12px;
      font-size: 21px;
    }

    .post-card p {
      color: #666;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .post-actions {
      display: flex;
      gap: 10px;
      align-items: center;
    }

    .delete-form {
      margin: 0;
    }

    .delete-btn {
      background: #b42318;
    }

    .delete-btn:hover {
      background: #8f1c13;
    }
  </style>
</head>

<body>

  <nav class="navbar">
    <h2>My Profile</h2>

    <a href="/logout" class="logout">Logout</a>
  </nav>

  <main class="container">

    <section class="profile-card">

      <h1>User Profile</h1>

      <div class="profile-info">

        <p>
          <span class="label">Username:</span>
          <%= user.username %>
        </p>

        <p>
          <span class="label">Email:</span>
          <%= user.email %>
        </p>

        <p>
          <span class="label">Role:</span>
          <%= user.role %>
        </p>

      </div>

      <div class="actions">

        <a href="/create" class="btn">
          Create Post
        </a>

        <% if (user.role === "user") { %>

          <a href="/edit-profile" class="btn">
            Edit Profile
          </a>

        <% } %>

      </div>

    </section>


    <h2 class="posts-title">Posts</h2>

    <section class="posts-container">

      <% posts.forEach(post => { %>

        <div class="post-card">

          <h2>
            <%= post.title %>
          </h2>

          <p>
            <%= post.content %>
          </p>

          <div class="post-actions">

            <a href="/edit/<%= post._id %>" class="btn">
              Edit
            </a>

            <form
              action="/delete/<%= post._id %>"
              method="POST"
              class="delete-form"
            >
              <button type="submit" class="btn delete-btn">
                Delete
              </button>
            </form>

          </div>

        </div>

      <% }) %>

    </section>

  </main>

</body>
</html>